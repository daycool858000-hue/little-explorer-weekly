{
  "name": "little-explorer-weekly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/content-validation.mjs && tsc --noEmit && vite build && node scripts/preview.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/run-reading-browser.mjs",
    "test:challenge": "node tests/phase4-challenge-browser.mjs",
    "test:speech": "node tests/phase4-speech-browser.mjs",
    "validate:content": "node scripts/content-validation.mjs",
    "build:review": "tsc --noEmit && vite build --mode review && node scripts/preview.mjs --review",
    "test:archive": "node tests/archive-browser.mjs",
    "test:legacy-browser": "node tests/browser.mjs",
    "review:readings": "node scripts/reading-review.mjs",
    "validate:planet": "node scripts/planet-validation.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "typescript": "~5.7.3",
    "eslint": "^9.19.0",
    "typescript-eslint": "^8.22.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "^1.58.0"
  }
}
